@echo off
setlocal enabledelayedexpansion

rem === 路径设置 ===
set "BC_DIR=D:\TOOL\Beyond Compare 3"
set "LIST_FILE=%BC_DIR%\compare_list.txt"
set "SCRIPT_FILE=%BC_DIR%\compare_temp.txt"
set "TEMP_CSV=%BC_DIR%\Reports\temp_result.csv"
set "SUMMARY_CSV=%BC_DIR%\Reports\summary_result.csv"

rem === 初始化总报告 ===
if exist "%SUMMARY_CSV%" del "%SUMMARY_CSV%"
echo SourceFile,CompareFile,IOriginal,IAdded,IDeleted,IChanged,UOriginal,UAdded,UDeleted,UChanged,LeftOnly,RightOnly,Different>"%SUMMARY_CSV%"

rem === 逐行比较 ===
for /f "usebackq tokens=1,2 delims=|" %%A in ("%LIST_FILE%") do (
    set "LEFT_FILE=%%A"
    set "RIGHT_FILE=%%B"

    echo Comparing:
    echo   Left : !LEFT_FILE!
    echo   Right: !RIGHT_FILE!

    if exist "%TEMP_CSV%" del "%TEMP_CSV%"

    > "%SCRIPT_FILE%" echo criteria rules-based
    >>"%SCRIPT_FILE%" echo file-report layout:statistics options:display-all output-to:"%TEMP_CSV%" "!LEFT_FILE!" "!RIGHT_FILE!"

    "%BC_DIR%\BComp.exe" @"%SCRIPT_FILE%"

    rem 跳过 temp_result.csv 的表头，只追加数据行
    for /f "usebackq skip=1 tokens=* delims=" %%L in ("%TEMP_CSV%") do (
        rem 原 CSV 字段顺序：
        rem SourceFile,CompareFile,IOriginal,IAdded,IDeleted,IChanged,UOriginal,UAdded,UDeleted,UChanged
        rem 这里暂时直接追加原始行
        echo %%L>>"%SUMMARY_CSV%"
    )
)

echo.
echo Done.
echo Summary: %SUMMARY_CSV%
pause